DATABASE_URL=sqlite+aiosqlite:///./cropsakha.db
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
ML_MODEL_TYPE=auto
ML_CONFIDENCE_HIGH=0.80
ML_CONFIDENCE_MEDIUM=0.50
ML_CONFIDENCE_LOW=0.30
MAX_IMAGE_SIZE_MB=10
UPLOAD_DIR=./uploads
APP_ENV=development
APP_DEBUG=true
